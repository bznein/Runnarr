# Stored as /srv/runnarr/environments/staging/base.env, owned by
# root:runnarr-deploy with mode 0640.
POSTGRES_USER=runnarr
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=runnarr
DATABASE_URL=postgres://runnarr:replace-with-url-encoded-password@db:5432/runnarr?sslmode=disable

RUNNARR_PUBLIC_MODE=true
# Staging keeps a local automation account only because Cloudflare Access is
# the outer boundary. Production must keep local login disabled.
RUNNARR_LOCAL_AUTH_ENABLED=true
RUNNARR_TRUST_PROXY=true
RUNNARR_ADMIN_USERNAME=staging-admin
RUNNARR_ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-real-bcrypt-hash'
RUNNARR_SECRET_KEY=replace-with-at-least-32-random-bytes

RUNNARR_OIDC_GOOGLE_CLIENT_ID=replace-with-staging-client-id
RUNNARR_OIDC_GOOGLE_CLIENT_SECRET=replace-with-staging-client-secret
RUNNARR_OIDC_ALLOWED_EMAILS=reviewer@example.com=staging-admin

# Provider write operations are unconfigured by default. Add only dedicated
# non-production accounts during an explicit integration smoke session.
RUNNARR_GOOGLE_CLIENT_ID=
RUNNARR_GOOGLE_CLIENT_SECRET=

RUNNARR_APP_CPU_LIMIT=1.0
RUNNARR_APP_MEMORY_LIMIT=1g
RUNNARR_DB_CPU_LIMIT=1.0
RUNNARR_DB_MEMORY_LIMIT=2g
RUNNARR_NETWORK_SUBNET=10.91.0.0/24
RUNNARR_NONPROD_INGRESS_NETWORK=runnarr-nonprod-ingress
