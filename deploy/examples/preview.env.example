# Stored as /srv/runnarr/config/preview.env, owned by
# root:runnarr-deploy with mode 0640.
# Generate a bcrypt hash for the shared preview password and keep the plaintext
# only in the reviewer password manager and GitHub preview environment.
RUNNARR_PREVIEW_ADMIN_PASSWORD_HASH='$2a$12$replace-with-a-real-bcrypt-hash'
